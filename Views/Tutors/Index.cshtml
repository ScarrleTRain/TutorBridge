@model IEnumerable<TutorBridge.ViewModels.Tutor>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Find a Tutor";
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Find a Tutor</h2>
    </div>

    <div class="card-body">
        <form method="get" asp-action="Index" class="d-flex gap-3 align-items-center flex-wrap pb-3 mb-4 border-bottom">
            <label for="subjectId" class="mb-0">Subject:</label>
            <select name="subjectId" id="subjectId" class="form-control form-control-sm" style="width:220px" onchange="this.form.submit()">
                <option value="">All subjects</option>
                @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Subjects)
                {
                    <option value="@item.Value" selected="@(ViewBag.SelectedSubjectId != null && item.Value == ViewBag.SelectedSubjectId.ToString())">@item.Text</option>
                }
            </select>
        </form>

        @if (!Model.Any())
        {
            <p class="text-muted">No tutors found for that subject yet.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var tutor in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="@(tutor.ProfilePhoto != null ? Url.Action("Photo", "Users", new { id = tutor.Id }) : Url.Content("~/images/tutors/default.jpg"))"
                                 class="card-img-top" style="height: 220px; object-fit: cover;"
                                 alt="@tutor.NameFirst @tutor.NameLast">
                            <div class="card-body d-flex flex-column">
                                <h3 class="h6">@tutor.NameFirst @tutor.NameLast</h3>
                                <div class="mb-2">
                                    @foreach (var subject in tutor.Subjects)
                                    {
                                        <span class="badge bg-secondary me-1">@subject.Name</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(tutor.Blurb))
                                {
                                    <p class="small text-muted flex-grow-1">@tutor.Blurb</p>
                                }
                                <a asp-action="Details" asp-route-id="@tutor.Id" class="btn btn-primary btn-sm mt-auto">View Profile</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>