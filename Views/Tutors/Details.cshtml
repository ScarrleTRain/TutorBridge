@model TutorBridge.ViewModels.Tutor

@{
    ViewData["Title"] = $"{Model.NameFirst} {Model.NameLast}";
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-person-badge me-2"></i>@Model.NameFirst @Model.NameLast</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Tutors
        </a>
    </div>

    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <img src="@(Model.ProfilePhoto != null ? Url.Action("Photo", "Users", new { id = Model.Id }) : Url.Content("~/images/tutors/default.jpg"))"
                     class="img-fluid rounded" alt="@Model.NameFirst @Model.NameLast">
            </div>

            <div class="col-md-8">
                <div class="mb-3">
                    @foreach (var subject in Model.Subjects)
                    {
                        <span class="badge bg-secondary me-1">@subject.Name</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Blurb))
                {
                    <p>@Model.Blurb</p>
                }

                <div class="pt-3 border-top mt-3">
                    <h3 class="h6"><i class="bi bi-clock me-1 text-primary"></i>Open Timeslots</h3>

                    @if (!Model.Timeslots.Any())
                    {
                        <p class="text-muted small">No open timeslots right now — check back soon.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var slot in Model.Timeslots)
                            {
                                <li class="list-group-item px-0">
                                    @slot.DateTimeStart.ToString("dd/MM/yyyy") &nbsp;
                                    @slot.DateTimeStart.ToString("h:mm tt") - @slot.DateTimeEnd.ToString("h:mm tt")
                                </li>
                            }
                        </ul>
                    }

                    <a asp-controller="Bookings" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-calendar-check me-1"></i>Book a Session
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>