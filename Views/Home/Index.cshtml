@model TutorBridge.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Identity
@using TutorBridge.Areas.Identity.Data

@inject SignInManager<User> SignInManager

@{
    ViewData["Title"] = "TutorBridge";
}

<div class="p-5 mb-5 bg-primary text-white rounded-3 text-center shadow-lg">
    <h1 class="display-5 fw-bold">Find the right tutor, fast.</h1>
    <p class="lead mb-4">Search by subject and connect with a tutor who fits.</p>

    <form method="get" asp-controller="Tutors" asp-action="Index" class="d-flex justify-content-center gap-2 flex-wrap">
        <select name="subjectId" class="form-control form-control-sm" style="width:240px">
            <option value="">All subjects</option>
            @foreach (var item in Model.Subjects)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <button type="submit" class="btn btn-light btn-sm">
            <i class="bi bi-search me-1"></i>Find a Tutor
        </button>
    </form>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Meet Our Tutors</h2>
        <a asp-controller="Tutors" asp-action="Index" class="btn btn-outline-primary btn-sm">View All Tutors</a>
    </div>

    @if (!Model.FeaturedTutors.Any())
    {
        <p class="text-muted">No tutors to show yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var tutor in Model.FeaturedTutors)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(tutor.ProfilePhoto != null ? Url.Action("Photo", "Users", new { id = tutor.Id }) : Url.Content("~/images/tutors/default.jpg"))"
                             class="card-img-top" style="height: 220px; object-fit: cover;"
                             alt="@tutor.NameFirst @tutor.NameLast">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h6">@tutor.NameFirst @tutor.NameLast</h3>
                            <div class="mb-2">
                                @foreach (var subject in tutor.Subjects)
                                {
                                    <span class="badge bg-secondary me-1">@subject.Name</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tutor.Blurb))
                            {
                                <p class="small text-muted flex-grow-1">@tutor.Blurb</p>
                            }
                            <a asp-controller="Tutors" asp-action="Details" asp-route-id="@tutor.Id" class="btn btn-primary btn-sm mt-auto">View Profile</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="card shadow-lg text-center">
    <div class="card-body py-5">
        @if (!SignInManager.IsSignedIn(User))
        {
            <h2 class="h4">Ready to get started?</h2>
            <p class="text-muted">Create a free account to book your first session.</p>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">Sign Up</a>
        }
        else if (User.IsInRole("Student"))
        {
            <h2 class="h4">Welcome back, @User.FirstName()!</h2>
            <p class="text-muted">Ready for your next session?</p>
            <a asp-controller="Tutors" asp-action="Index" class="btn btn-primary btn-lg">Book a Session</a>
        }
        else if (User.IsInRole("Tutor"))
        {
            <h2 class="h4">Welcome back, @User.FirstName()!</h2>
            <p class="text-muted">Check your upcoming sessions and availability.</p>
            <a asp-controller="Timeslots" asp-action="Index" class="btn btn-primary btn-lg">View My Schedule</a>
        }
        else if (User.IsInRole("Admin"))
        {
            <h2 class="h4">Welcome back, @User.FirstName()!</h2>
            <a asp-controller="Home" asp-action="Admin" class="btn btn-primary btn-lg">Go to Dashboard</a>
        }
    </div>
</div>