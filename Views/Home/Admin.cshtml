@model TutorBridge.ViewModels.AdminDashboardViewModel
@inject IWebHostEnvironment Env
@using System.ComponentModel
@using System.Reflection

@{

    ViewData["Title"] = "Home Page";
}

<div>
    @* .row.g-2.justify-content-center>(.col-sm-12.text-center>h2{Admin Dashboard})+.col-sm-3*12>a[href="#"].text-reset.text-decoration-none>.card.text-wrap.text-center.shadow>(.card-header>h3{Card $}.card-title)+(.card-body>p) *@
    <div class="row g-2 justify-content-center">
        <div class="col-sm-12 text-center">
            <h2>Admin Dashboard</h2>
        </div>
        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-header"><h5 class="mb-0">Users by Role</h5></div>
                <div class="card-body"><canvas id="usersByRoleChart"></canvas></div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-header"><h5 class="mb-0">Bookings by Status</h5></div>
                <div class="card-body"><canvas id="bookingsByStatusChart"></canvas></div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-header"><h5 class="mb-0">Sessions per Tutor</h5></div>
                <div class="card-body"><canvas id="sessionsPerTutorChart"></canvas></div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow h-100">
                <div class="card-header"><h5 class="mb-0">Bookings Over Time</h5></div>
                <div class="card-body"><canvas id="bookingsOverTimeChart"></canvas></div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-header"><h5 class="mb-0">Upcoming Sessions</h5></div>
                <ul class="list-group list-group-flush">
                    @foreach (var s in Model.UpcomingSessions)
                    {
                        <li class="list-group-item">
                            @s.StartTime.ToString("ddd d MMM, HH:mm") — @s.StudentName with @s.TutorName (@s.Subject)
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
    <script>
        new Chart(document.getElementById('usersByRoleChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.UsersByRole.Labels)),
                datasets: [{ data: @Html.Raw(Json.Serialize(Model.UsersByRole.Values)) }]
            }
        });

        new Chart(document.getElementById('bookingsByStatusChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.BookingsByStatus.Labels)),
                datasets: [{ data: @Html.Raw(Json.Serialize(Model.BookingsByStatus.Values)) }]
            }
        });

        new Chart(document.getElementById('sessionsPerTutorChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SessionsPerTutor.Labels)),
                datasets: [{ label: 'Sessions', data: @Html.Raw(Json.Serialize(Model.SessionsPerTutor.Values)) }]
            },
            // plugins: [ChartDataLabels],
            options: { plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('bookingsOverTimeChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.BookingsOverTime.Select(w => w.WeekLabel))),
                datasets: [{ label: 'Bookings', data: @Html.Raw(Json.Serialize(Model.BookingsOverTime.Select(w => w.Count))), tension: 0.3 }]
            }
        });
    </script>
}