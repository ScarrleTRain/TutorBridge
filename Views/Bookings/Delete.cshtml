@model TutorBridge.Models.Booking

@{
    ViewData["Title"] = "Delete";
}

<div class="card shadow-lg">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete Booking</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this Booking? <b>This action cannot be undone.</b></p>

        <dl class="row mb-0">
            @if (Model.User != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>User Name
                </dt>
                <dd class="col-md-9">
                    @Model.User.NameFirst @Model.User.NameLast <span class="text-secondary">(@Model.UserId)</span>
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>User Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.UserId)
                </dd>
            }

            @if (Model.Timeslot != null )
            {
                if (Model.Timeslot.Tutor != null)
                {
                    <dt class="col-md-3">
                        <i class="bi-person-badge me-1 text-primary"></i>Tutor
                    </dt>
                    <dd class="col-md-9">
                        @Model.Timeslot.Tutor.NameFirst @Model.Timeslot.Tutor.NameLast <span class="text-secondary">(@Model.Timeslot.Tutor.Id)</span>
                    </dd>
                }
                else
                {
                    <dt class="col-md-3">
                        <i class="bi-person-badge me-1 text-primary"></i>Tutor
                    </dt>
                    <dd class="col-md-9">
                        @Model.Timeslot.TutorId
                    </dd>
                }

                <dt class="col-md-3">
                    <i class="bi bi-clock me-1 text-primary"></i>Time Slot
                </dt>
                <dd class="col-md-9">
                    @{
                        var time = $"{Model.Timeslot.DateTimeStart:d}, {Model.Timeslot.DateTimeStart:t} - {Model.Timeslot.DateTimeEnd:t}";
                    }
                    @time <span class="text-secondary">(@Model.TimeslotId)</span>
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-clock me-1 text-primary"></i>Time Slot Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.TimeslotId)
                </dd>
            }

            @if (Model.Subject != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-book me-1 text-primary"></i>Subject
                </dt>
                <dd class="col-md-9">
                    @Model.Subject.Name <span class="text-secondary">(@Model.SubjectId)</span>
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-book me-1 text-primary"></i>Subject Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.SubjectId)
                </dd>
            }

            <dt class="col-md-3">
                <i class="bi bi-info-circle me-1 text-primary"></i>Status
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>

        <form asp-action="Delete" class="col-12 pt-2 border-top mt-3">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>