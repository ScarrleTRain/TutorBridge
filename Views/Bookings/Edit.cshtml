@model TutorBridge.Models.Booking

@{
    ViewData["Title"] = "Edit";
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-calendar-plus me-2"></i>Edit Booking</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <form asp-action="Edit" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="col-md-6">
                @{
                    ViewData["FieldName"] = "UserId";
                    ViewData["LabelText"] = "User";
                    ViewData["IconClass"] = "bi bi-person-badge";
                    ViewData["Placeholder"] = "-- Select User --";
                    ViewData["SearchPlaceholder"] = "Search users...";
                    ViewData["CurrentValue"] = Model.UserId?.ToString();
                }
                <partial name="_CustomSelectPartial" model="ViewBag.Users" />
            </div>

            <div class="col-md-6">
                @{
                    ViewData["FieldName"] = "TimeSlotId";
                    ViewData["LabelText"] = "Timeslot";
                    ViewData["IconClass"] = "bi bi-calendar-plus me-2";
                    ViewData["Placeholder"] = "-- Select Timeslot --";
                    ViewData["SearchPlaceholder"] = "Search timeslots...";
                    ViewData["CurrentValue"] = Model.TimeSlotId.ToString();
                }
                <partial name="_CustomSelectPartial" model="ViewBag.Timeslots" />
            </div>

            <div class="col-md-6">
                @{
                    ViewData["FieldName"] = "SubjectId";
                    ViewData["LabelText"] = "Subject";
                    ViewData["IconClass"] = "bi bi-calendar-plus me-2";
                    ViewData["Placeholder"] = "-- Select Subject --";
                    ViewData["SearchPlaceholder"] = "Search subjects...";
                    ViewData["CurrentValue"] = Model.SubjectId.ToString();
                }
                <partial name="_CustomSelectPartial" model="ViewBag.Subjects" />
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label">
                    <i class="bi bi-flag me-1 text-primary"></i>Status
                </label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<TutorBridge.Models.Booking.BookingStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-12 pt-2 border-top mt-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}