@model TutorBridge.Models.Booking
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject IWebHostEnvironment Env
@using System.Text.Json

@{
    ViewData["Title"] = "Book";

    string? photoPath = ViewBag.Tutor.ProfilePhoto != null
        ? System.IO.Path.Combine(Env.WebRootPath, "images", "tutors", ViewBag.Tutor.ProfilePhoto)
        : null;
    bool photoExists = photoPath != null && System.IO.File.Exists(photoPath);
    var timeslotJson = JsonSerializer.Serialize(ViewBag.Timeslots);
    
}

<style>
    .fc-event {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
        border-radius: 0.375rem; /* matches bs-border-radius */
    }

    .fc-event:hover {
        filter: brightness(0.92);
        cursor: pointer;
    }

    .fc-event-selected {
        outline: 2px solid var(--bs-secondary);
        outline-offset: 1px;
    }

    .fc-toolbar-title {
        font-size: 1.1rem !important;
        font-weight: 600;
    }

    .fc-event-main {
        height: 100%;
        display: flex;
        align-items: center;
    }
</style>

<h1>Book</h1>
<hr />
<div class="row">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <img class="card-img-top" src="~/images/tutors/@(photoExists ? ViewBag.Tutor.ProfilePhoto : "default.jpg")" alt="@ViewBag.Tutor.NameFirst @ViewBag.Tutor.NameLast">
                <div class="card-body">
                    <h5 class="card-title">@ViewBag.Tutor.NameFirst @ViewBag.Tutor.NameLast</h5>
                    <p class="card-text">@ViewBag.Tutor.Blurb</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div id="calendar" class="mb-3"></div>
            <div id="slot-feedback" class="alert alert-info d-none mb-3">
                No timeslot selected.
            </div>
        </div>

        <div class="col-md-3">
            <form asp-action="Book">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="TimeslotId" id="TimeslotId" />
                <div class="form-group mb-3">
                    <label asp-for="SubjectId" class="control-label">Subject</label>
                    <select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-control">
                        <option value="">-- Select a subject --</option>
                    </select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" id="submit-btn" class="btn btn-primary w-100" disabled>
                        Confirm Booking
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
    window.__timeslotEvents = @Json.Serialize(ViewBag.Timeslots);
</script>
<script src="~/js/calendar-common.js"></script>
<script src="~/js/calendar-book.js"></script>
