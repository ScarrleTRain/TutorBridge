@using System.Security.Claims
@model TutorBridge.Models.Booking

@{
    ViewData["Title"] = "Details";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canRespond = Model.Status == Booking.BookingStatus.Pending
        && Model.Timeslot?.TutorId == currentUserId;
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-info-circle me-2"></i>Booking Details</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            @if (Model.User != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>User Name
                </dt>
                <dd class="col-md-9">
                    @Model.User.NameFirst @Model.User.NameLast @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
                    {
                        <span class="text-secondary">(@Model.UserId)</span>
                    }
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>User Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.UserId)
                </dd>
            }

            @if (Model.Timeslot != null)
            {
                if (Model.Timeslot.Tutor != null)
                {
                    <dt class="col-md-3">
                        <i class="bi-person-badge me-1 text-primary"></i>Tutor
                    </dt>
                    <dd class="col-md-9">
                        @Model.Timeslot.Tutor.NameFirst @Model.Timeslot.Tutor.NameLast @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
                        {
                            <span class="text-secondary">(@Model.Timeslot.Tutor.Id)</span>
                        }
                    </dd>
                }
                else
                {
                    <dt class="col-md-3">
                        <i class="bi-person-badge me-1 text-primary"></i>Tutor
                    </dt>
                    <dd class="col-md-9">
                        @Model.Timeslot.TutorId
                    </dd>
                }

                <dt class="col-md-3">
                    <i class="bi bi-clock me-1 text-primary"></i>Time Slot
                </dt>
                <dd class="col-md-9">
                    @{
                        var time = $"{Model.Timeslot.DateTimeStart:d}, {Model.Timeslot.DateTimeStart:t} - {Model.Timeslot.DateTimeEnd:t}";
                    }
                    @time 
                    @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
                    {
                        <span class="text-secondary">(@Model.TimeslotId)</span>
                    }
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-clock me-1 text-primary"></i>Time Slot Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.TimeslotId)
                </dd>
            }

            @if (Model.Subject != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-book me-1 text-primary"></i>Subject
                </dt>
                <dd class="col-md-9">
                    @Model.Subject.Name @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
                    {
                        <span class="text-secondary">(@Model.SubjectId)</span>
                    }
                </dd>
            }
            else
            {
                <dt class="col-md-3">
                    <i class="bi bi-book me-1 text-primary"></i>Subject Id
                </dt>
                <dd class="col-md-9">
                    @Html.DisplayFor(model => model.SubjectId)
                </dd>
            }

            <dt class="col-md-3">
                <i class="bi bi-info-circle me-1 text-primary"></i>Status
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>
        @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
        {
            <div class="col-12 pt-2 border-top mt-3 d-flex gap-2">
                @if (canRespond)
                {
                    <form asp-action="Confirm" asp-route-id="@Model.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>Confirm
                        </button>
                    </form>
                    <form asp-action="Deny" asp-route-id="@Model.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-lg me-1"></i>Deny
                        </button>
                    </form>
                }
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>            
        }
    </div>
</div>