@model TutorBridge.Models.TimeSlot

@{
    ViewData["Title"] = "Details";
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-calendar-event me-2"></i>TimeSlot Details</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-md-3">
                <i class="bi bi-person-badge me-1 text-primary"></i>Tutor Id
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.TutorId)
            </dd>

            @if (Model.Tutor != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>Tutor Name
                </dt>
                <dd class="col-md-9">
                    @Model.Tutor.NameFirst @Model.Tutor.NameLast
                </dd>
            }

            <dt class="col-md-3">
                <i class="bi bi-clock me-1 text-primary"></i>Start
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.DateTimeStart)
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-clock-history me-1 text-primary"></i>End
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.DateTimeEnd)
            </dd>
        </dl>

        <div class="col-12 pt-2 border-top mt-3">
            <a asp-action="Edit" asp-route-id="@Model?.TimeSlotId" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
        </div>
    </div>
</div>