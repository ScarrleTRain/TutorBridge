@model TutorBridge.Models.Timeslot
@using System.Security.Claims

@{
    ViewData["Title"] = "Create";
}
@* <div asp-validation-summary="All" class="text-danger"></div> *@
<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-calendar-plus me-2"></i>Create Timeslot</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <form asp-action="Create" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-6">
                @if (User.IsInRole("Tutor"))
                {
                    <label class="form-label">
                        <i class="bi bi-person-badge me-1 text-primary"></i>Tutor
                    </label>
                    <input type="text" class="form-control" value="@User.FindFirstValue("FullName")" disabled />
                    <input type="hidden" name="TutorId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
                }
                else
                {
                    ViewData["FieldName"] = "TutorId";
                    ViewData["LabelText"] = "Tutor";
                    ViewData["IconClass"] = "bi bi-person-badge";
                    ViewData["Placeholder"] = "-- Select Tutor --";
                    ViewData["SearchPlaceholder"] = "Search tutors...";
                    
                    <partial name="_CustomSelectPartial" model="ViewBag.Tutors" />
                }
            </div>

            <div class="col-md-3">
                <label asp-for="DateTimeStart" class="form-label">
                    <i class="bi bi-clock me-1 text-primary"></i>Start
                </label>
                <input asp-for="DateTimeStart" class="form-control" />
                <span asp-validation-for="DateTimeStart" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DateTimeEnd" class="form-label">
                    <i class="bi bi-clock-history me-1 text-primary"></i>End
                </label>
                <input asp-for="DateTimeEnd" class="form-control" />
                <span asp-validation-for="DateTimeEnd" class="text-danger small"></span>
            </div>

            <div class="col-12 pt-2 border-top mt-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Create
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function() {
            const startInput = document.getElementById('DateTimeStart');
            const endInput = document.getElementById('DateTimeEnd');
            const SESSION_MINUTES = 60;

            function toLocalInputValue(date) {
                const pad = n => String(n).padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}` +
                    `T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            }

            startInput.addEventListener('change', function() {
                if (!startInput.value) return;

                const start = new Date(startInput.value);
                const end = new Date(start.getTime() + SESSION_MINUTES * 60000);

                endInput.value = toLocalInputValue(end);
            });
        })();
    </script>
}