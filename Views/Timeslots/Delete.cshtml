@model TutorBridge.Models.TimeSlot

@{
    ViewData["Title"] = "Delete";
}

<div class="card shadow-lg">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete TimeSlot</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this Timeslot? <b>This action cannot be undone.</b></p>

        <dl class="row mb-0">
            <dt class="col-md-3">
                <i class="bi bi-person-badge me-1 text-primary"></i>Tutor Id
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.TutorId)
            </dd>

            @if (Model.Tutor != null)
            {
                <dt class="col-md-3">
                    <i class="bi bi-person-badge me-1 text-primary"></i>Tutor Name
                </dt>
                <dd class="col-md-9">
                    @Model.Tutor.NameFirst @Model.Tutor.NameLast
                </dd>
            }

            <dt class="col-md-3">
                <i class="bi bi-clock me-1 text-primary"></i>Start
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.DateTimeStart)
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-clock-history me-1 text-primary"></i>End
            </dt>
            <dd class="col-md-9">
                @Html.DisplayFor(model => model.DateTimeEnd)
            </dd>
        </dl>

        <form asp-action="Delete" class="col-12 pt-2 border-top mt-3">
            <input type="hidden" asp-for="TimeSlotId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>