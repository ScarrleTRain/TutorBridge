@model IEnumerable<TutorBridge.Models.Timeslot>

@{
    ViewData["Title"] = "Index";
    ViewData["NoContainer"] = true;

    HashSet<int> bookedIds = ViewBag.BookedIds;

    var events = Model.Select(t => new {
        id = t.TimeslotId,
        title = t.Tutor?.NameFirst + " " + t.Tutor?.NameLast ?? "Error", // Find whether booked or not
        start = t.DateTimeStart,
        end = t.DateTimeEnd,
        isBooked = bookedIds.Contains(t.TimeslotId)
    });
}

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script src="https://unpkg.com/@@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css"/>
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/themes/light.css"/>
<style>
    .fc-event {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
        border-radius: 0.375rem; /* matches bs-border-radius */
    }

    .fc-event:hover {
        filter: brightness(0.92);
        cursor: pointer;
    }

    .fc-event-selected {
        outline: 2px solid var(--bs-secondary);
        outline-offset: 1px;
    }

    .fc-toolbar-title {
        font-size: 1.1rem !important;
        font-weight: 600;
    }

    .fc-event-main {
        height: 100%;
        display: flex;
        align-items: center;
    }
</style>

<div class="card shadow-lg m-3 mx-xxl-auto mx-xl-3" style="max-width: calc(1400px - 2rem);">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Timeslots</h2>
        <a asp-action="Create" class="btn btn-primary bg-secondary btn-sm">+ Create New</a>
    </div>

    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

<script>
    window.__timeslotEvents = @Json.Serialize(events);
    window.__timeslotUrls = {
        edit: '@Url.Action("Edit", "Timeslots")',
        details: '@Url.Action("Details", "Timeslots")',
        delete: '@Url.Action("Delete", "Timeslots")'
    };
</script>
<script src="~/js/calendar-common.js"></script>
<script src="~/js/calendar-timeslots.js"></script>