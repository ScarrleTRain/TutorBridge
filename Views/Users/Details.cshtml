@model TutorBridge.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="card shadow-lg">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0"><i class="bi bi-info-circle me-2"></i>User Details</h2>
        <a asp-action="Index" class="btn btn-primary bg-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-md-3">
                <i class="bi bi-person me-1 text-primary"></i>Name
            </dt>
            <dd class="col-md-9">
                @Model.NameFirst @Model.NameLast <span class="text-secondary">(@Model.Id)</span>
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-envelope me-1 text-primary"></i>Email
            </dt>
            <dd class="col-md-9">
                @Model.Email
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-telephone me-1 text-primary"></i>Phone
            </dt>
            <dd class="col-md-9">
                @(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-calendar-heart me-1 text-primary"></i>Birth Date
            </dt>
            <dd class="col-md-9">
                @Model.BirthDate.ToString("d")
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-flag me-1 text-primary"></i>Role
            </dt>
            <dd class="col-md-9">
                @Model.Role
            </dd>

            <dt class="col-md-3">
                <i class="bi bi-chat-left-text me-1 text-primary"></i>Blurb
            </dt>
            <dd class="col-md-9">
                @(string.IsNullOrEmpty(Model.Blurb) ? "—" : Model.Blurb)
            </dd>
        </dl>

        <div class="col-12 pt-2 border-top mt-3 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </div>
</div>
