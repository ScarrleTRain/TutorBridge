@using Microsoft.AspNetCore.Identity
@using TutorBridge.Areas.Identity.Data
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TutorBridge</title>
    <script type="importmap"></script>
    <script src="~/js/custom-dropdown.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TutorBridge.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar-float-wrapper d-inline-block position-relative m-3">
            <div class="position-relative d-inline-flex align-items-start">
                <button class="navbar-toggler custom-toggler d-inline-flex align-items-center shadow rounded-5 text-bg-primary fw-bold" 
                        type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" 
                        aria-expanded="false" 
                        aria-label="Toggle navigation">
                    <span class="navbar-brand">TutorBridge</span><i class="bi bi-list" style="font-size: 24px;"></i>
                </button>
                @* FIX SNAP *@
                <div class="navbar-collapse collapse collapse-horizontal floating-menu position-absolute top-0 bg-primary-subtle rounded-5 shadow">
                    <div class="floating-menu-inner d-flex flex-row align-items-center g-4 ">
                        <ul class="navbar-nav fw-bold">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Admin">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Subjects" asp-action="Index">Subjects</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Tutor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Timeslots" asp-action="Index">Timeslots</a>
                                </li>
                            }
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="login position-absolute top-0 d-inline-flex align-items-center shadow rounded-5 text-bg-primary fw-bold">
                <div class="floating-menu-inner d-flex flex-row align-items-center g-4">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        @Html.AntiForgeryToken()
                        <div class="dropdown">
                            <button class="btn btn-link text-white position-relative" type="button"
                                    id="notificationToggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bell fs-5"></i>
                                @await Component.InvokeAsync("NotificationBadge")
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-2" id="notificationDropdown">
                            </div>
                        </div>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @{
        bool useContainer = ViewData["NoContainer"] as bool? != true;

        if (useContainer)
        {
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        }
        else
        {
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        }
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TutorBridge - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
