@page
@model TutorBridge.Areas.Identity.Pages.Account.Manage.SubjectsModel
@{
    ViewData["Title"] = "Subjects";
    ViewData["ActivePage"] = ManageNavPages.Subjects;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    @{
        ViewData["FieldName"] = "Input.SelectedSubjectIds";
        ViewData["LabelText"] = "Subjects you teach";
        ViewData["SearchPlaceholder"] = "Search subjects...";
    }
    <partial name="_ChecklistMultiSelectPartial" model="@Model.SubjectOptions" />

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checklist-multiselect.js"></script>
}
