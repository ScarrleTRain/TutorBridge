@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg text-center" style="max-width: 480px; width: 100%;">
        <div class="card-header bg-danger text-white">
            <h2 class="h5 mb-0"><i class="bi bi-shield-lock me-2"></i>Access Denied</h2>
        </div>

        <div class="card-body py-4">
            <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-1 fs-5">You do not have access to this resource.</p>
            <p class="text-muted small mb-4">If you believe this is a mistake, please contact an administrator.</p>

            <a href="/" class="btn btn-primary">
                <i class="bi bi-house-door me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>